# Python
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Node / frontend
node_modules/
dist/
*.local

# Database & runtime data (real host telemetry)
*.db
*.db-shm
*.db-wal
*.sqlite*

# Anchored with a leading slash on purpose. As a bare "database/" this also
# matched backend/database/ - the core source package holding models.py and
# connection.py - so `git add` refused those paths and any NEW file added to
# backend/database/ would have silently failed to commit.
/database/
/pg/
/pgsql/
postgres*.zip
postgres*.log

# Generated artifacts
/reports/
logs/
build/
*.log

# Dev / tooling
.edge-profile/
.vite/
.opencode/
dev/

# Certificates (ephemeral, machine-specific)
certs/baraq.crt
certs/baraq.key
certs/baraq.pfx
certs/baraq.thumbprint
certs/_c.pub
certs/_k.pub

# Any key material, anywhere, regardless of name.
# This repository is PUBLIC: a committed private key or a still-valid server
# certificate is world-readable and must never be pushed. Use a company-issued
# certificate path supplied through BARAQ_TLS_CERTFILE / BARAQ_TLS_KEYFILE at
# runtime instead. *.pub stays committable - it is the pinned public half.
certs/
*.key
*.pfx
*.p12
*.jks
*.keystore
*.crt
*.cer
*.der
*.pem

# Environment & secrets
.env
.env.*
secrets.dat
secrets.key
secrets.tmp
# One-time bootstrap password written next to the executable; never commit.
first_run_credentials.txt

# Per-host agent configs / keys (generated; never commit real keys)
agent_configs/*.json
!agent_configs/company-fleet.json
!agent_configs/README.md

# Archives
*.zip

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Prometheus scrape credential (dev default; never commit real keys)
deploy/prometheus/.scrape-key

# Database backups (large dumps / encrypted archives - never commit)
backups/

# SigmaHQ community rules (regenerated by scripts/sigma_pull.py; keep the curated set)
sigma_rules/*
!sigma_rules/baraq/

# Vendor license-signing private key (never commit)
licensing/private_key.pem

database/*.sentinel.lock
.aider*

# Temp data & caches
tmp_data/
datasets/
*.pyc

# Runtime state (dev launcher writes its pid here)
.backend.pid
